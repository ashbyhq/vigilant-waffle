{
  "name": "ashby-www",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "PORT=3010 next-remote-watch ./content ./meta ./config.json",
    "build": "next build --webpack",
    "prebuild": "node scripts/update_config_preview_app.js",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint-style": "stylelint --config '.stylelintrc.yml'",
    "lint-styles": "yarn lint-style -- '**/*.scss' '**/*.css'",
    "lint-ts": "oxlint --config .oxlintrc.json src",
    "lint": "yarn lint-styles && yarn lint-ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "export": "yarn lint && OUTPUT_EXPORT=1 yarn build",
    "test": "vitest run"
  },
  "dependencies": {
    "@artsy/fresnel": "8.5.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@stitches/react": "^1.2.8",
    "@svgr/webpack": "8.1.0",
    "framer-motion": "14.10.1",
    "gray-matter": "4.0.3",
    "gsap": "3.15.1",
    "html-loader": "5.1.0",
    "js-yaml": "5.5.0",
    "just-camel-case": "6.2.0",
    "next": "16.4.5",
    "next-remote-watch": "2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-gsap": "^3.2.1",
    "react-merge-refs": "3.0.2",
    "react-parallax-tilt": "1.7.351",
    "sanitize.css": "13.0.0",
    "sass": "1.108.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "postcss": "8.5.32",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.3",
    "stylelint-scss": "7.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "yaml-loader": "0.9.0"
  },
  "resolutions": {
    "@babel/helper-create-regexp-features-plugin": "7.29.10",
    "ajv": "8.20.0",
    "anymatch/picomatch": "2.3.2",
    "brace-expansion": "1.1.21",
    "braces": "3.0.3",
    "deepmerge": "npm:deepmerge-ts@8.0.2",
    "express": "4.22.3",
    "gray-matter/js-yaml": "3.15.2",
    "micromatch/picomatch": "2.3.2",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
